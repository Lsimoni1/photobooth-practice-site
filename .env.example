# Copy this file to .env.local for local dev, and set the same values
# in your Vercel project's Environment Variables for production.

# --- Stripe (test mode) ---
# From https://dashboard.stripe.com/test/apikeys
# Server-side only — used by api/create-checkout-session.ts. Never expose this in frontend code.
STRIPE_SECRET_KEY=replace_with_your_stripe_test_secret_key

# --- EmailJS ---
# From https://dashboard.emailjs.com/admin
# These are safe to expose in the frontend (that's how EmailJS is designed to work).
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
